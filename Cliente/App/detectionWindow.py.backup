from PyQt5.QtWidgets import QMainWindow, QLabel, QFrame, QProgressBar
from PyQt5.QtCore import pyqtSignal, pyqtSlot, Qt, QTimer, QPropertyAnimation, QEasingCurve
from PyQt5.QtGui import QImage, QPixmap, QFont, QPalette, QColor
from PyQt5.uic import loadUi
from App.detection import Detection  # Importar la versión ultra optimizada
import os
import sys
import logging

class DetectionWindow(QMainWindow):
    closed = pyqtSignal()

    def __init__(self, token, location, receiver):
        super(DetectionWindow, self).__init__()
        ui_file = self.resource_path('UI/monitoringCameraWindow.ui')
        loadUi(ui_file, self)
        
        self.token = token
        self.location = location
        self.receiver = receiver
        self.model_path = self.resource_path("model/predict.pt")
        self.detection = None
        
        # Configuraciones de rendimiento
        self.fps_counter = 0
        self.fps_start_time = 0
        self.last_fps_update = 0
        
        # Configurar interfaz optimizada
        self.setup_optimized_ui()
        
        # Configurar botón de parar
        self.stopButton.clicked.connect(self.close_detection)
        
        # Configurar notificaciones mejoradas
        self.setup_enhanced_notifications()
        
        # Configurar indicadores de rendimiento
        self.setup_performance_indicators()
        
        # Iniciar detección
        self.createDetectionInstance()
        logging.info("DetectionWindow ultra optimizada inicializada")

    def setup_optimized_ui(self):
        """Configurar interfaz optimizada para mejor rendimiento"""
        # Configurar ventana principal
        self.setFixedSize(1000, 600)
        self.setWindowTitle("🔍 Weapon Detection System - Monitoring (Ultra Optimized)")
        
        # Optimizar el label de la cámara
        self.CameraLabel.setGeometry(50, 50, 640, 480)
        self.CameraLabel.setStyleSheet("""
            QLabel {
                border: 2px solid #3b82f6;
                border-radius: 8px;
                background-color: #1e293b;
                color: #94a3b8;
                font-size: 16px;
                font-weight: bold;
                font-family: 'Segoe UI', Arial, sans-serif;
            }
        """)
        self.CameraLabel.setAlignment(Qt.AlignCenter)
        self.CameraLabel.setText("🎥 Initializing Ultra-Fast Camera...\nPlease wait while the optimized system starts")
        
        # Optimizar botón de parada
        self.stopButton.setGeometry(320, 545, 200, 45)
        self.stopButton.setStyleSheet("""
            QPushButton {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                    stop:0 #ef4444, stop:1 #dc2626);
                color: white;
                border: none;
                border-radius: 8px;
                font-size: 14px;
                font-weight: bold;
                padding: 12px;
            }
            QPushButton:hover {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                    stop:0 #dc2626, stop:1 #b91c1c);
            }
            QPushButton:pressed {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                    stop:0 #b91c1c, stop:1 #991b1b);
            }
        """)

    def setup_enhanced_notifications(self):
        """Configurar sistema de notificaciones mejorado"""
        # Notificación principal de arma detectada (más grande y llamativa)
        self.weaponNotificationLabel = QLabel("", self)
        self.weaponNotificationLabel.setGeometry(720, 80, 260, 120)
        self.weaponNotificationLabel.setAlignment(Qt.AlignCenter)
        self.weaponNotificationLabel.setWordWrap(True)
        self.weaponNotificationLabel.setStyleSheet("""
            QLabel {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                    stop:0 rgba(239, 68, 68, 240), 
                    stop:1 rgba(220, 38, 38, 240));
                color: white;
                font-size: 16px;
                font-weight: bold;
                border: 3px solid #dc2626;
                border-radius: 12px;
                padding: 15px;
                font-family: 'Segoe UI', Arial, sans-serif;
            }
        """)
        self.weaponNotificationLabel.hide()
        
        # Notificación de estado del sistema
        self.statusNotificationLabel = QLabel("", self)
        self.statusNotificationLabel.setGeometry(720, 220, 260, 60)
        self.statusNotificationLabel.setAlignment(Qt.AlignCenter)
        self.statusNotificationLabel.setStyleSheet("""
            QLabel {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                    stop:0 rgba(34, 197, 94, 200), 
                    stop:1 rgba(21, 128, 61, 200));
                color: white;
                font-size: 12px;
                font-weight: bold;
                border: 2px solid #16a34a;
                border-radius: 8px;
                padding: 8px;
                font-family: 'Segoe UI', Arial, sans-serif;
            }
        """)
        self.statusNotificationLabel.setText("🟢 Sistema Optimizado Activo\n📊 Análisis cada 3 segundos")
        self.statusNotificationLabel.show()
        
        # Timer para ocultar notificación de arma
        self.weapon_timer = QTimer()
        self.weapon_timer.timeout.connect(self.hide_weapon_notification)

    def setup_performance_indicators(self):
        """Configurar indicadores de rendimiento"""
        # FPS Counter
        self.fpsLabel = QLabel("FPS: 0", self)
        self.fpsLabel.setGeometry(720, 300, 120, 30)
        self.fpsLabel.setStyleSheet("""
            QLabel {
                background-color: rgba(30, 41, 59, 180);
                color: #60a5fa;
                font-size: 11px;
                font-weight: bold;
                border: 1px solid #3b82f6;
                border-radius: 6px;
                padding: 6px;
                font-family: 'Courier New', monospace;
            }
        """)
        
        # Analysis Status
        self.analysisLabel = QLabel("Análisis: Listo", self)
        self.analysisLabel.setGeometry(850, 300, 130, 30)
        self.analysisLabel.setStyleSheet("""
            QLabel {
                background-color: rgba(30, 41, 59, 180);
                color: #34d399;
                font-size: 11px;
                font-weight: bold;
                border: 1px solid #10b981;
                border-radius: 6px;
                padding: 6px;
                font-family: 'Courier New', monospace;
            }
        """)
        
        # Barra de rendimiento
        self.performanceBar = QProgressBar(self)
        self.performanceBar.setGeometry(720, 340, 260, 12)
        self.performanceBar.setRange(0, 100)
        self.performanceBar.setValue(0)
        self.performanceBar.setStyleSheet("""
            QProgressBar {
                border: 2px solid #374151;
                border-radius: 6px;
                background-color: #1f2937;
                text-align: center;
                color: white;
                font-size: 10px;
            }
            QProgressBar::chunk {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                    stop:0 #10b981, stop:1 #059669);
                border-radius: 4px;
            }
        """)
        
        # Contador de detecciones
        self.detectionCountLabel = QLabel("Detecciones: 0", self)
        self.detectionCountLabel.setGeometry(720, 365, 260, 25)
        self.detectionCountLabel.setStyleSheet("""
            QLabel {
                background-color: rgba(30, 41, 59, 150);
                color: #fbbf24;
                font-size: 11px;
                font-weight: bold;
                border: 1px solid #f59e0b;
                border-radius: 6px;
                padding: 4px;
                font-family: 'Segoe UI', Arial, sans-serif;
            }
        """)
        
        self.detection_count = 0
        
        # Timer para actualizar FPS
        self.fps_timer = QTimer()
        self.fps_timer.timeout.connect(self.update_fps_display)
        self.fps_timer.start(1000)  # Actualizar cada segundo

    def createDetectionInstance(self):
        """Crear instancia de detección ultra optimizada"""
        if self.detection is None:
            self.detection = Detection(self.model_path, self.token, self.location, self.receiver)
            
            # Conectar señales optimizadas
            self.detection.changePixmap.connect(self.setImage)
            self.detection.weaponDetected.connect(self.show_weapon_notification_enhanced)
            self.detection.resourceUpdate.connect(self.updateResourceInfo)
            self.detection.error.connect(self.handleDetectionError)
            
            # Inicializar contadores
            import time
            self.fps_start_time = time.time()
            self.fps_counter = 0
            
            # Iniciar detección
            self.detection.start()
            logging.info("Instancia de Detection ultra optimizada creada y iniciada")

    @pyqtSlot(QImage)
    def setImage(self, image):
        """Actualizar imagen de la cámara con contador de FPS"""
        self.CameraLabel.setPixmap(QPixmap.fromImage(image))
        
        # Contar FPS
        self.fps_counter += 1

    def update_fps_display(self):
        """Actualizar display de FPS"""
        import time
        current_time = time.time()
        elapsed = current_time - self.fps_start_time
        
        if elapsed >= 1.0:
            fps = self.fps_counter / elapsed
            self.fpsLabel.setText(f"FPS: {fps:.1f}")
            
            # Actualizar barra de rendimiento basada en FPS
            performance = min(100, (fps / 30) * 100)  # 30 FPS = 100%
            self.performanceBar.setValue(int(performance))
            
            # Resetear contador
            self.fps_counter = 0
            self.fps_start_time = current_time

    @pyqtSlot(dict)
    def updateResourceInfo(self, resources):
        """Actualizar información de recursos optimizada"""
        try:
            # Solo actualizar etiquetas si existen
            if hasattr(self, 'cpuLabel'):
                self.cpuLabel.setText(f"CPU: {resources['cpu']:.1f}%")
            
            if hasattr(self, 'memoryLabel'):
                self.memoryLabel.setText(f"Memory: {resources['memory']:.1f}%")
            
            if hasattr(self, 'gpuLabel'):
                if 'gpu_load' in resources:
                    self.gpuLabel.setText(f"GPU: {resources['gpu_load']:.1f}%")
                else:
                    self.gpuLabel.setText("GPU: N/A")
                    
        except Exception as e:
            logging.debug(f"Error actualizando recursos: {e}")

    @pyqtSlot(str)
    def show_weapon_notification_enhanced(self, message):
        """Mostrar notificación de arma detectada mejorada"""
        # Incrementar contador
        self.detection_count += 1
        self.detectionCountLabel.setText(f"🔍 Detecciones: {self.detection_count}")
        
        # Actualizar estado de análisis
        self.analysisLabel.setText("Análisis: ¡ARMA!")
        self.analysisLabel.setStyleSheet("""
            QLabel {
                background-color: rgba(239, 68, 68, 200);
                color: white;
                font-size: 11px;
                font-weight: bold;
                border: 1px solid #dc2626;
                border-radius: 6px;
                padding: 6px;
                font-family: 'Courier New', monospace;
            }
        """)
        
        # Mostrar notificación principal con animación
        self.weaponNotificationLabel.setText(f"🚨 ALERTA DE SEGURIDAD\n\n{message}\n\n⏰ {self.get_current_time()}")
        
        # Efecto de aparición con animación
        self.weaponNotificationLabel.show()
        self.create_pulse_animation()
        
        # Auto-ocultar después de 5 segundos
        self.weapon_timer.start(5000)
        
        # Restaurar estado de análisis después de 3 segundos
        QTimer.singleShot(3000, self.restore_analysis_status)
        
        logging.info(f"Notificación mejorada de arma mostrada: {message}")

    def create_pulse_animation(self):
        """Crear animación de pulso para la notificación"""
        self.pulse_animation = QPropertyAnimation(self.weaponNotificationLabel, b"geometry")
        self.pulse_animation.setDuration(300)
        
        # Geometría original
        original_rect = self.weaponNotificationLabel.geometry()
        
        # Geometría expandida (efecto de pulso)
        expanded_rect = original_rect.adjusted(-10, -10, 10, 10)
        
        self.pulse_animation.setStartValue(original_rect)
        self.pulse_animation.setEndValue(expanded_rect)
        self.pulse_animation.setEasingCurve(QEasingCurve.OutBounce)
        
        # Animación de vuelta
        self.pulse_back_animation = QPropertyAnimation(self.weaponNotificationLabel, b"geometry")
        self.pulse_back_animation.setDuration(200)
        self.pulse_back_animation.setStartValue(expanded_rect)
        self.pulse_back_animation.setEndValue(original_rect)
        self.pulse_back_animation.setEasingCurve(QEasingCurve.InQuart)
        
        # Conectar animaciones
        self.pulse_animation.finished.connect(self.pulse_back_animation.start)
        self.pulse_animation.start()

    def restore_analysis_status(self):
        """Restaurar estado normal de análisis"""
        self.analysisLabel.setText("Análisis: Activo")
        self.analysisLabel.setStyleSheet("""
            QLabel {
                background-color: rgba(30, 41, 59, 180);
                color: #34d399;
                font-size: 11px;
                font-weight: bold;
                border: 1px solid #10b981;
                border-radius: 6px;
                padding: 6px;
                font-family: 'Courier New', monospace;
            }
        """)

    def get_current_time(self):
        """Obtener hora actual formateada"""
        import datetime
        return datetime.datetime.now().strftime("%H:%M:%S")

    def hide_weapon_notification(self):
        """Ocultar notificación de arma con efecto de desvanecimiento"""
        # Animación de desvanecimiento
        self.fade_animation = QPropertyAnimation(self.weaponNotificationLabel, b"windowOpacity")
        self.fade_animation.setDuration(500)
        self.fade_animation.setStartValue(1.0)
        self.fade_animation.setEndValue(0.0)
        self.fade_animation.setEasingCurve(QEasingCurve.OutQuart)
        
        self.fade_animation.finished.connect(lambda: self.weaponNotificationLabel.hide())
        self.fade_animation.finished.connect(lambda: self.weaponNotificationLabel.setWindowOpacity(1.0))
        
        self.fade_animation.start()
        self.weapon_timer.stop()

    @pyqtSlot(str)
    def handleDetectionError(self, error_message):
        """Manejar errores de detección con notificación visual"""
        logging.error(f"Error en la detección: {error_message}")
        
        # Mostrar error en el label de análisis
        self.analysisLabel.setText("Análisis: ERROR")
        self.analysisLabel.setStyleSheet("""
            QLabel {
                background-color: rgba(239, 68, 68, 200);
                color: white;
                font-size: 11px;
                font-weight: bold;
                border: 1px solid #dc2626;
                border-radius: 6px;
                padding: 6px;
                font-family: 'Courier New', monospace;
            }
        """)
        
        # Restaurar después de 5 segundos
        QTimer.singleShot(5000, self.restore_analysis_status)

    def setup_keyboard_shortcuts(self):
        """Configurar atajos de teclado"""
        from PyQt5.QtWidgets import QShortcut
        from PyQt5.QtGui import QKeySequence
        
        # Espacio para pausar/reanudar
        self.pause_shortcut = QShortcut(QKeySequence("Space"), self)
        self.pause_shortcut.activated.connect(self.toggle_detection)
        
        # Escape para cerrar
        self.close_shortcut = QShortcut(QKeySequence("Escape"), self)
        self.close_shortcut.activated.connect(self.close_detection)

    def toggle_detection(self):
        """Alternar detección (pausar/reanudar)"""
        if hasattr(self.detection, 'analysis_running'):
            if self.detection.analysis_running:
                self.detection.analysis_running = False
                self.statusNotificationLabel.setText("⏸️ Sistema Pausado\n🔄 Presiona ESPACIO para reanudar")
                self.statusNotificationLabel.setStyleSheet("""
                    QLabel {
                        background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                            stop:0 rgba(245, 158, 11, 200), 
                            stop:1 rgba(217, 119, 6, 200));
                        color: white;
                        font-size: 12px;
                        font-weight: bold;
                        border: 2px solid #f59e0b;
                        border-radius: 8px;
                        padding: 8px;
                        font-family: 'Segoe UI', Arial, sans-serif;
                    }
                """)
            else:
                self.detection.analysis_running = True
                self.statusNotificationLabel.setText("🟢 Sistema Optimizado Activo\n📊 Análisis cada 3 segundos")
                self.statusNotificationLabel.setStyleSheet("""
                    QLabel {
                        background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                            stop:0 rgba(34, 197, 94, 200), 
                            stop:1 rgba(21, 128, 61, 200));
                        color: white;
                        font-size: 12px;
                        font-weight: bold;
                        border: 2px solid #16a34a;
                        border-radius: 8px;
                        padding: 8px;
                        font-family: 'Segoe UI', Arial, sans-serif;
                    }
                """)

    def closeEvent(self, event):
        """Evento de cierre de ventana optimizado"""
        logging.info("Cerrando DetectionWindow ultra optimizada")
        
        # Detener timers
        if hasattr(self, 'fps_timer'):
            self.fps_timer.stop()
        if hasattr(self, 'weapon_timer'):
            self.weapon_timer.stop()
        
        # Cerrar detección
        self.close_detection()
        self.closed.emit()
        super().closeEvent(event)

    def close_detection(self):
        """Cerrar detección y limpiar recursos optimizado"""
        if self.detection:
            # Mostrar mensaje de cierre
            self.statusNotificationLabel.setText("🔴 Cerrando Sistema...\n⏳ Liberando recursos")
            self.statusNotificationLabel.setStyleSheet("""
                QLabel {
                    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                        stop:0 rgba(239, 68, 68, 200), 
                        stop:1 rgba(220, 38, 38, 200));
                    color: white;
                    font-size: 12px;
                    font-weight: bold;
                    border: 2px solid #dc2626;
                    border-radius: 8px;
                    padding: 8px;
                    font-family: 'Segoe UI', Arial, sans-serif;
                }
            """)
            
            # Detener detección de forma segura
            self.detection.stop()
            self.detection.wait(2000)  # Esperar máximo 2 segundos
            
            if self.detection.isRunning():
                self.detection.terminate()
                self.detection.wait(1000)
            
            self.detection = None
            logging.info("Detección ultra optimizada detenida correctamente")

    def resource_path(self, relative_path):
        """Obtener ruta de recurso"""
        if hasattr(sys, '_MEIPASS'):
            return os.path.join(sys._MEIPASS, relative_path)
        return os.path.join(os.path.abspath("."), relative_path)